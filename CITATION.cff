    given-names: "Nicholas G."
    affiliation: "Booth School of Business, University of Chicago"
  - family-names: Sokolov
    given-names: Vadim
    affiliation: "George Mason University"
    email: vsokolov@gmu.edu
keywords:
  - generative Bayesian computation
  - simulation-based inference
  - quantile neural network
  - amortized inference
  - extreme value theory
